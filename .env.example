# ============================================================
#  SkyObserv – Environment Variables Template
#  Copy this file: cp .env.example .env
#  Then fill in your actual credentials.
# ============================================================

# ── PostgreSQL ──────────────────────────────────────────────
DATABASE_URL=postgres://USER:PASSWORD@HOST:PORT/DBNAME?sslmode=require

# ── OpenSearch ──────────────────────────────────────────────
OPENSEARCH_URL=https://USER:PASSWORD@HOST:PORT

# ── SkyWalking OAP ──────────────────────────────────────────
# For Docker Compose: http://localhost:12800 (OAP starts automatically)
# For cloud/K8s:      http://<oap-service>:12800
SKYWALKING_ENDPOINT=http://localhost:12800

# ── Tambo AI ────────────────────────────────────────────────
TAMBO_API_KEY=your_tambo_api_key_here

# ── App ─────────────────────────────────────────────────────
PORT=5000
NODE_ENV=development
