# ============================================================
#  SkyObserv – Environment Variables Template
#  Copy this file: cp .env.example .env
# ============================================================

DATABASE_URL=postgres://USER:PASSWORD@HOST:PORT/DBNAME?sslmode=require
OPENSEARCH_URL=https://USER:PASSWORD@HOST:PORT
SKYWALKING_ENDPOINT=http://localhost:12800
SKYWALKING_GRPC_COLLECTOR=your-oap-host:11800
TAMBO_API_KEY=your_tambo_api_key_here

PORT=5000
NODE_ENV=development

# Auth — email/password signup, forgot password via Brevo OTP
SKYOBSERV_AUTH_ENABLED=false
SESSION_SECRET=change-this-to-a-long-random-string
SKYOBSERV_ADMIN_EMAIL=admin@yourcompany.com
SKYOBSERV_ADMIN_PASSWORD=change-me

# Brevo (REST API key xkeysib-...)
BREVO_API_KEY=xkeysib-your-api-key
EMAIL_FROM_ADDRESS=your-verified-sender@example.com
EMAIL_FROM_NAME=SkyObserv
