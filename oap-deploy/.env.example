# Copy to .env on AWS EC2: cp .env.example .env
# Then run: ./ec2-docker-run.sh

# Aiven OpenSearch — SkyWalking OAP stores traces/metrics here
OPENSEARCH_HOST=skyobserve-es-travobuds-stg.f.aivencloud.com:16148
OPENSEARCH_USER=avnadmin
OPENSEARCH_PASSWORD=your_password_here

# Optional — Kubernetes monitoring (lab / remote kubeconfig on EC2)
# K8S_MONITORING_ENABLED=true
# KUBECONFIG_HOST_PATH=/home/ubuntu/.kube/config
# MINIKUBE_HOME_PATH=/home/ubuntu/.minikube
